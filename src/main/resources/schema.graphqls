enum CourseResult {
    NO_RESULT_YET
    COURSE_FAILED
    COURSE_PASSED
}

type Program {
    id: ID!
    name: String!
    description: String
    courses: [Course]
}

type Course {
    id: ID!
    name: String!
    description: String
    completion: Float!
    incorrectAttempts: Int!
    courseResult: CourseResult!
    modules: [Module]
}

type Module {
    id: ID!
    name: String!
    isComplete: Boolean!
    incorrectAttempts: Int!
    task: Task
}

type Task {
    id: ID!
    name: String!
}

type Mutation {
    resetCourse(courseId:String):Course
    taskAttempt(courseId:String!, moduleId:String!, isCorrect:Boolean!):Course
}

type Query {
    fetchProgram(id:String!): Program
    fetchCourse(id:String!): Course
}

