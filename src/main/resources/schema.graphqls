enum CourseResult {
    NO_RESULT_YET
    COURSE_FAILED
    COURSE_PASSED
}

type UserProgram {
    id: ID!
    name: String!
    description: String
    userCourses: [UserCourse]
}

type UserCourse {
    id: ID!
    name: String!
    description: String
    completion: Float!
    attemptLimit: Int!
    incorrectAttempts: Int!
    courseResult: CourseResult!
    userModules: [UserModule]
}

type UserModule {
    id: ID!
    name: String!
    isComplete: Boolean!
    incorrectAttempts: Int!
}

type Mutation {
    resetUserCourse(courseId:String):UserCourse
    taskAttempt(courseId:String!, moduleId:String!, isCorrect:Boolean!):UserCourse
}

type Query {
    userPrograms: [UserProgram]
    userProgram(id:String!): UserProgram
    userCourse(id:String!): UserCourse
}